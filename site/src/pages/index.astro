  .seg + .seg { border-left: 1.5px solid var(--madder); }
  .seg[aria-selected='true'] { background: var(--madder); color: var(--paper); }
  .seg:focus-visible, .frame:focus-visible, .step:focus-visible { outline: 2px solid var(--madder); outline-offset: 4px; }
  /* "Coming Soon" in a thin rounded outline (Ed, Nov 2026): a label, not a
     button, in the pill's red. */
  .soon { color: var(--sepia); margin: 3.2rem 0 0; font-size: 1.1rem; text-align: center; }
  /* Words picked out in madder, the colour of "Coming Soon". */
  .madder { color: var(--madder); }
  .underline, .underline .fx-ch { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .18em; }
  .soon > span {
    color: var(--madder);          /* the filled pill's red-orange, in both modes */
    cursor: pointer;               /* the hand, like a button (Ed, Nov 2026) */
    display: inline-block;
    padding: .35em 1.3em .4em;
    border: 1px solid currentColor;
    border-radius: 999px;
  }

  /* ---- Stage ---- */
  .stage { display: flex; flex-direction: column; align-items: center; }
  /* Sized by the device showing, so the hint sits just below it. */
  .devices { position: relative; display: grid; place-items: center; --h: min(64vh, 660px); }
  .device {
    grid-area: 1 / 1;
    margin: 0;
    transition: opacity .55s ease, transform .55s cubic-bezier(.2, .7, .2, 1), filter .55s;
  }
  /* The hidden device fades out over the other and takes no room. */
  .device[data-active='false'] { position: absolute; top: 0; left: 0; right: 0; width: fit-content; margin: 0 auto; opacity: 0; transform: scale(.94) translateY(12px); filter: blur(2px); pointer-events: none; }

  .frame {
    position: relative;
    display: block;
    padding: var(--bezel);
    border: 0;
    border-radius: var(--r-outer);
    background: #0b0b0c;
    cursor: zoom-in;
    /* Titanium edge, then a soft sepia shadow onto the paper. */
    box-shadow:
      0 0 0 1.5px #5d5a55,
      0 0 0 3px #2b2a28,
