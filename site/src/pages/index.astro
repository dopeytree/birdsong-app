  .stage { container-type: inline-size; }
  .ipad[data-landscape='true'] { --h: min(46vh, 440px, calc(100cqw / 1.5)); --ar: 2266 / 1488; --bezel: calc(var(--h) * .06); --r-outer: calc(var(--h) * .076); --r-inner: calc(var(--h) * .046); }
  /* Size changes animate only once the page has loaded (.ready). */
  .ready .frame { transition: transform .3s ease, padding .6s ease, border-radius .6s ease; }
  .ready .screen { transition: height .6s ease, aspect-ratio .6s ease, border-radius .6s ease; }
  .ipad .frame { box-shadow:
      0 0 0 1.5px #6a6761, 0 0 0 3px #3a3936,
      0 2px 3px 3px rgba(42, 36, 28, .25),
      0 30px 60px -10px rgba(66, 48, 28, .45),
      0 60px 120px -30px rgba(66, 48, 28, .35); }

  .island {
    position: absolute;
    top: 1.5%; left: 50%;
    width: 23.5%; height: 4.1%;
    transform: translateX(-50%);
    border-radius: 999px;
    background: #000;
  }
  .btn { position: absolute; width: 4px; background: #3b3a37; border-radius: 2px; left: -6px; }
  .b1 { top: 13%; height: 3.5%; }
  .b2 { top: 21%; height: 6.5%; }
  .b3 { top: 29.5%; height: 6.5%; }
  .b4 { left: auto; right: -6px; top: 23%; height: 10%; }

  /* The plate's "‹ —— Index of Species | 42 ——" line, reused for the shots. */
  .index {
    display: flex; align-items: center; gap: .8rem;
    margin-top: 2rem;
    font-family: var(--fell-sc);
    letter-spacing: .05em;
    font-size: 1.15rem;
  }
  .index[hidden] { display: none; }
  .rule { display: inline-block; width: 3rem; height: 1px; background: var(--rule); }
  .step { border: 0; background: none; color: var(--sepia); cursor: pointer; font-size: 1.3rem; padding: 0 .3rem; }
  /* Hidden everywhere for now (Ed, Nov 2026); the pointer turns to a
     magnifier over the screen instead. */
  .hint { display: none; color: var(--sepia); margin: 1rem 0 0; font-size: 1rem; }

  footer {
    display: flex; align-items: center; justify-content: center; gap: .8rem;
    padding: 0 20px 24px;
    color: var(--sepia);
    font-size: .9rem;
    font-style: italic;
  }
  /* min-height so the footer doesn't jump between lines. */
  .credit { display: inline-block; min-height: 1.5em; white-space: nowrap; }
  .cr-ch { display: inline-block; transition: transform .9s cubic-bezier(.2, .7, .2, 1), opacity .7s ease; }
  @media (max-width: 520px) { footer .rule { display: none; } }

  /* iPhone-style notification: frosted glass and the system font, as on iOS.
     Icon: the cardinal from the app's loading screen, on paper. */
  .notices {
    position: fixed; z-index: 50;
    top: 12px; left: 50%;
    transform: translateX(-50%);
    width: min(calc(100vw - 16px), 400px);
    display: flex; flex-direction: column; gap: 8px;
    pointer-events: none;
  }
  /* On wider screens the stack lines up with the heading's left edge (the
     page's width and padding, as in .page); phones keep it centred. */
  @media (min-width: 821px) {
    .notices { left: calc(max(0px, (100vw - 1240px) / 2) + clamp(20px, 5vw, 64px)); transform: none; }
  }
  .notice {
    pointer-events: auto;
    display: flex; align-items: center; gap: 11px;
    padding: 11px 14px 12px 11px;
    border-radius: 22px;
    background: rgba(250, 247, 240, .72);
    backdrop-filter: blur(24px) saturate(1.6);
    -webkit-backdrop-filter: blur(24px) saturate(1.6);
    box-shadow: 0 10px 34px rgba(42, 36, 28, .2), 0 0 0 .5px rgba(42, 36, 28, .1);
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', system-ui, sans-serif;
    color: #1c1c1e;
    cursor: pointer;
