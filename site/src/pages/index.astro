  .shot {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    transition: opacity .4s ease;
  }
  .shot[data-active='false'] { opacity: 0; }

  .iphone { --bezel: calc(var(--h) * .016); --ar: 1179 / 2556; --r-outer: calc(var(--h) * .085); --r-inner: calc(var(--h) * .07); }
  .ipad   { --bezel: calc(var(--h) * .04);  --ar: 1488 / 2266; --r-outer: calc(var(--h) * .05);  --r-inner: calc(var(--h) * .03); }
  /* Sideways iPad: --h is now the short side. */
