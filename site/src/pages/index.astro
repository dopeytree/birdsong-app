    width: 2.5em; height: 1px;
    margin-right: .6em;
    vertical-align: .3em;
    background: currentColor;
    opacity: .6;
  }

  /* The app's mic / listen pill, reused as the device switch. */
  /* Centred under the device (Ed, Nov 2026). */
  .pill {
    display: flex;
    width: fit-content;
    margin: 1.8rem auto 0;
    border: 1.5px solid var(--madder);
    border-radius: 999px;
    overflow: hidden;
  }
  .seg {
    border: 0;
    background: transparent;
    color: var(--seg-ink);
    font-family: var(--fell-sc);
    font-size: 1.1rem;
    letter-spacing: .05em;
    padding: .45em 1.3em .5em;
