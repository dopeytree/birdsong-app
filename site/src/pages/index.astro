  }
  .kicker em { font-family: var(--fell); letter-spacing: 0; font-size: 1.2rem; }
  /* A short ruled line after the tagline, matching the one before the attribution. */
  .kicker::after { content: ''; width: 2.5em; height: 1px; background: currentColor; opacity: .6; }
  .dot { width: .6em; height: .6em; border-radius: 50%; background: var(--madder); display: inline-block; animation: listen 2.4s ease-in-out infinite; }
  @keyframes listen { 50% { opacity: .35; } }
  /* The heading shrinks to fit its column ("Birdsongs.ai" is about 5.7 em). */
  .text { container-type: inline-size; }
  h1 {
    font-family: var(--fell-sc);
    font-weight: normal;
    font-size: min(clamp(3rem, 7vw, 5.4rem), 16.5cqw);
